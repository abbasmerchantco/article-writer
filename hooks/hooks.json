{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/gate-guard.sh",
            "statusMessage": "article-writer: checking deliverable-write is legitimate",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
