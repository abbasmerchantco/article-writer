# Run artifacts. The plugin allocates these in the *current working directory*, so
# testing it from the repo root drops real runs (drafts, research, state.json) here.
/input/
/interim/
/output/

# Local Claude Code state (machine-specific permissions, not project config)
.claude/settings.local.json

# Editor / OS noise
.DS_Store
*.swp
*~
.idea/
.vscode/

# Python bytecode from the scripts' embedded python3 blocks
__pycache__/
*.pyc
