# Run artifacts. The plugin allocates one flat folder per run (YYYYMMDD-NNNNN-slug) in
# the *current working directory* unless output_root is set, so testing it from the
# repo root drops real runs (scope.md, article.md, .article-writer/) here.
/[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]-*/

# Local Claude Code state (machine-specific permissions, not project config)
.claude/settings.local.json

# Editor / OS noise
.DS_Store
*.swp
*~
.idea/
.vscode/

# Python bytecode from the scripts' embedded python3 blocks
__pycache__/
*.pyc
